APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OAuth social login (Laravel Socialite)
# Register apps at: https://console.cloud.google.com, https://github.com/settings/developers,
# https://gitlab.com/-/profile/applications, https://developer.atlassian.com/cloud/bitbucket/
# The redirect URI for each provider is http://localhost:8000/auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:8000/auth/gitlab/callback

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_REDIRECT_URI=http://localhost:8000/auth/bitbucket/callback

# Payment gateways (Flutterwave + Pesapal)
# Bank transfer details shown to buyers on the shared checkout page.
PAYMENTS_CURRENCY=USD
PAYMENTS_BANK_ENABLED=true
PAYMENTS_BANK_NAME=
PAYMENTS_BANK_ACCOUNT_NAME=
PAYMENTS_BANK_ACCOUNT_NUMBER=
PAYMENTS_BANK_CODE=
PAYMENTS_RETURN_URL=/credits
PAYMENTS_NOTIFY_URL=/payments/notify

PAYMENTS_FLUTTERWAVE_ENABLED=true
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

PAYMENTS_PESAPAL_ENABLED=true
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_CURRENCY=KES
PAYMENTS_WORLDREMIT_ENABLED=true
PAYMENTS_WORLDREMIT_COUNTRY=Uganda
PAYMENTS_WORLDREMIT_PROVIDER="MTN Mobile Money"
PAYMENTS_WORLDREMIT_NUMBER=0786634306
PAYMENTS_WORLDREMIT_ACCOUNT_NAME="Emmanuel Adonyo"

VITE_APP_NAME="${APP_NAME}"

# Feature flags
FEATURE_BATTLES=false
FEATURE_LINKEDIN_ONBOARDING=false
FEATURE_PROFILE_COMPLETION=true
FEATURE_EVIDENCE_PIPELINE=true
FEATURE_COMPANIES=true
FEATURE_CREDITS=true
FEATURE_VERIFICATION=true
FEATURE_AUTO_SCAN=true
FEATURE_PUBLIC_PRESENCE=true
